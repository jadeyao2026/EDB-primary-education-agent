# --- required ---
# The only third-party key you need to run the agent.
ANTHROPIC_API_KEY=sk-ant-...

# --- model connection (optional) ---
# Leave blank to talk to https://api.anthropic.com. Set it to point the agent at any
# endpoint that speaks the Anthropic Messages API (a gateway, a proxy, another platform).
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# Then name the models that endpoint actually serves, and verify with:
#   python -m app.cli health

# --- notifications (optional) ---
# Where change alerts are POSTed. Leave blank to run in dry-run mode,
# which prints the exact same message to the console instead.
# Try https://webhook.site to get a throwaway URL.
WEBHOOK_URL=
# If set, every request carries an X-EDB-Signature: sha256=<hmac> header.
WEBHOOK_SECRET=

# --- optional tuning ---
EDB_DB_PATH=data/edb.db
# Be polite: identify yourself to the government site with a real contact.
EDB_USER_AGENT=EDB-primary-education-agent/0.1 (+contact: you@example.com)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5-20251001
# Seconds to wait between requests to edb.gov.hk.
EDB_CRAWL_DELAY=1.0
# Hours a cached page is considered fresh.
EDB_CACHE_TTL_HOURS=24
# Off means edb.gov.hk is fetched directly, ignoring the system proxy. Set it to true only if a
# corporate proxy is your only route out. A local VPN client is usually the wrong route.
EDB_TRUST_ENV_PROXY=false
